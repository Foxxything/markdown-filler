{
    "name": "foxxything/markdown-filler",
    "description": "A simple library to replace placeholders in Markdown files.",
    "license": "GPL-3.0-only",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Foxxything\\MarkdownFiller\\": "src/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": [
            "@composer dump-autoload",
            "vendor/bin/phpunit tests"
        ]
    }
}
